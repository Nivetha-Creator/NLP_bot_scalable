# Application
APP_NAME=NLP Chatbot API
APP_ENV=development
DEBUG=false

# Database (defaults to sqlite:///chatbot.db in the project root)
DATABASE_URL=sqlite:///./chatbot.db

# Server
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# JWT authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
